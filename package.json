{
  "name": "myta-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "myTA: a pixel study buddy that floats over any note-taking app, checks your work and gives hints without giving the answer.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.json && electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "e2e": "electron-vite build && node e2e/run.mjs",
    "selftest": "electron-vite build && electron . --selftest",
    "livetest": "electron-vite build && electron . --livetest",
    "icon": "electron scripts/make-icon.cjs",
    "postinstall": "node scripts/fetch-assets.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "koffi": "^2.9.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-vite": "^2.3.0",
    "playwright": "^1.49.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "koffi@2.16.3": true,
    "esbuild@0.21.5": true
  }
}
